cabal-version:   3.0
name:            cabal-solver-plan
version:         0.1.0.0
license:         NONE
author:          andrea@andreabedini.com
maintainer:      Andrea Bedini
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall

executable cabal-solver-plan
    import:           warnings
    main-is:          Main.hs
    other-modules:    IndexTar
                    , Plan
                    , SetupDeps
                    , Options
                    , SolverInterface
                    , SourcePackage.Lens
    build-depends:    base ^>= 4.21.0.0 || ^>= 4.22.0.0
                    , aeson ^>= 2.3.2.0
                    , aeson-pretty ^>= 0.8.10
                    , binary ^>= 0.8.9.3
                    , bytestring ^>= 0.12.2.0
                    , filepath ^>= 1.5.4.0
                    , directory ^>= 1.3.9.0
                    , Cabal ^>= 3.18.1.0
                    , Cabal-syntax ^>= 3.18.1.0
                    , cabal-install ^>= 3.18.1.0
                    , cabal-install-solver ^>= 3.18.1.0
                    , containers ^>= 0.7 || ^>= 0.8
                    , data-fix ^>= 0.3.4
                    , hackage-security ^>= 0.6.4.0
                    , hackage-security-HTTP ^>= 0.1.1.3
                    , microlens ^>= 0.5.0.0
                    , monoidal-containers ^>= 0.6.8.0
                    , network-uri ^>= 2.6.4.2
                    , optparse-applicative ^>= 0.19.0.0
                    , prettyprinter ^>= 1.7.2
                    , recursion-schemes ^>= 5.2.3
                    , semialign ^>= 1.4
                    , tar ^>= 0.7.2.0
                    , text ^>= 2.1.2
                    , these ^>= 1.2.1
                    , time ^>= 1.14 || ^>= 1.15
    hs-source-dirs:   app
    default-language: GHC2021
