cabal-version:   3.0
name:            cabal-solver-plan
-- x-release-please-start-version
version:         0.0.0
-- x-release-please-end
synopsis:        Run cabal-install's solver with every input given on the command line
category:        Distribution
homepage:        https://github.com/andreabedini/cabal-solver-plan
bug-reports:     https://github.com/andreabedini/cabal-solver-plan/issues
license:         MIT
license-file:    LICENSE
author:          Andrea Bedini
maintainer:      andrea@bedini.au
build-type:      Simple
extra-doc-files: CHANGELOG.md
                 README.md

source-repository head
    type:     git
    location: https://github.com/andreabedini/cabal-solver-plan.git

common warnings
    ghc-options: -Wall

executable cabal-solver-plan
    import:           warnings
    main-is:          Main.hs
    other-modules:    IndexTar
                    , Plan
                    , SetupDeps
                    , Options
                    , SolverInterface
                    , Log
                    , SourcePackage.Lens
                    , Paths_cabal_solver_plan
    autogen-modules:  Paths_cabal_solver_plan
    build-depends:    base ^>= 4.21.0.0 || ^>= 4.22.0.0
                    , aeson ^>= 2.3.2.0
                    , aeson-pretty ^>= 0.8.10
                    , binary ^>= 0.8.9.3
                    , bytestring ^>= 0.12.2.0
                    , co-log-core ^>= 0.3.2.7
                    , filepath ^>= 1.5.4.0
                    , directory ^>= 1.3.9.0
                    , Cabal ^>= 3.18.1.0
                    , Cabal-syntax ^>= 3.18.1.0
                    , cabal-install ^>= 3.18.1.0
                    , cabal-install-solver ^>= 3.18.1.0
                    , containers ^>= 0.7 || ^>= 0.8
                    , data-fix ^>= 0.3.4
                    , hackage-security ^>= 0.6.4.0
                    , hackage-security-HTTP ^>= 0.1.1.3
                    , microlens ^>= 0.5.0.0
                    , monoidal-containers ^>= 0.6.8.0
                    , network-uri ^>= 2.6.4.2
                    , optparse-applicative ^>= 0.19.0.0
                    , prettyprinter ^>= 1.7.2
                    , recursion-schemes ^>= 5.2.3
                    , semialign ^>= 1.4
                    , tar ^>= 0.7.2.0
                    , text ^>= 2.1.2
                    , these ^>= 1.2.1
                    , time ^>= 1.14 || ^>= 1.15
    hs-source-dirs:   app
    default-language: GHC2021
